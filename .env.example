GEMINI_API_KEY=
TAVILY_API_KEY=
HF_TOKEN=
Groq_key=
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=
serp_api_key=
perplexity_key=
Pinecone_api_key=
INDEX_NAME=
Neo4j_Client_ID=
Neo4j_Client_Secret_key=
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
AURA_INSTANCEID=
AURA_INSTANCENAME=


# ── Agent Latency Timeouts (seconds) & Max Generation Tokens ──────────────
# Planner Agent
PLANNER_TIMEOUT_S=60
PLANNER_MAX_TOKENS=1024

# Orchestrator Agent
ORCHESTRATOR_TIMEOUT_S=90
ORCHESTRATOR_MAX_TOKENS=1024

# Retrieval Sufficiency Grader (Production CRAG)
RETRIEVAL_GRADER_TIMEOUT_S=90
RETRIEVAL_GRADER_MAX_TOKENS=512

# Answer Generator Agent
GENERATOR_TIMEOUT_S=200
GENERATOR_MAX_TOKENS=1024

# Post-Generation Groundedness Guardrail (Single-Pass Judge)
GENERATION_GUARDRAIL_TIMEOUT_S=90
GENERATION_GUARDRAIL_MAX_TOKENS=512

# Feedback Diagnostic Agent
FEEDBACK_TIMEOUT_S=90
FEEDBACK_MAX_TOKENS=512

# Qdrant Vector Search & MCP Tool Server Timeouts
QDRANT_TIMEOUT_S=30
MCP_TIMEOUT_S=15

# Server Ports (8600-8602 avoid Windows Hyper-V / WSL reserved port conflicts)
API_PORT=8600
API_SERVER_URL=http://127.0.0.1:8600
STREAMLIT_PORT=8601
STREAMLIT_SERVER_PORT=8601
MCP_PORT=8602
MCP_SERVER_URL=http://127.0.0.1:8602

# Hybrid Retrieval (Dense Vector + BM25 Sparse Keyword)
ENABLE_BM25_RETRIEVAL=true
RETRIEVER_MODE=hybrid
BM25_WEIGHT=0.5
DENSE_WEIGHT=0.5
